#pragma once

// Чистий DSP-код без залежностей від JUCE: фільтри та pitch-shifter.

#include <algorithm>
#include <cmath>
#include <complex>
#include <vector>

namespace rose
{
constexpr double kPi = 3.14159265358979323846;

// Якщо HPF стоїть на мінімумі, а LPF на максимумі - фільтр вважається вимкненим.
constexpr double kHpfOffHz = 20.5;
constexpr double kLpfOffHz = 19990.0;

//==============================================================================
// Коефіцієнти біквада (RBJ cookbook). Рахуємо в double - низькі частоти HPF
// у float дають шум та нестабільність.
struct BiquadCoeffs
{
    double b0 = 1.0, b1 = 0.0, b2 = 0.0, a1 = 0.0, a2 = 0.0;

    static BiquadCoeffs make (bool highPass, double fs, double freq, double q)
    {
        freq = std::clamp (freq, 5.0, 0.45 * fs);
        const double w0 = 2.0 * kPi * freq / fs;
        const double cw = std::cos (w0);
        const double alpha = std::sin (w0) / (2.0 * q);
        const double a0 = 1.0 + alpha;

        BiquadCoeffs c;
        if (highPass)
        {
            c.b0 = (1.0 + cw) * 0.5;
            c.b1 = -(1.0 + cw);
            c.b2 = c.b0;
        }
        else
        {
            c.b0 = (1.0 - cw) * 0.5;
            c.b1 = 1.0 - cw;
            c.b2 = c.b0;
        }
        c.b0 /= a0;
        c.b1 /= a0;
        c.b2 /= a0;
        c.a1 = (-2.0 * cw) / a0;
        c.a2 = (1.0 - alpha) / a0;
        return c;
    }

    // Модуль АЧХ на заданій частоті (для малювання кривої фільтра)
    double magnitude (double freq, double fs) const
    {
        const double w = 2.0 * kPi * freq / fs;
        const std::complex<double> z1 = std::polar (1.0, -w);
        const std::complex<double> z2 = z1 * z1;
        const std::complex<double> num = b0 + b1 * z1 + b2 * z2;
        const std::complex<double> den = 1.0 + a1 * z1 + a2 * z2;
        return std::abs (num / den);
    }
};

struct Biquad
{
    double z1 = 0.0, z2 = 0.0;

    void reset() noexcept { z1 = z2 = 0.0; }

    inline double process (double x, const BiquadCoeffs& c) noexcept
    {
        const double y = c.b0 * x + z1;
        z1 = c.b1 * x - c.a1 * y + z2;
        z2 = c.b2 * x - c.a2 * y;
        return y;
    }
};

// slopeIndex 0 = 12 dB/oct (1 біквад), 1 = 24 dB/oct (2 біквади, Баттерворт 4-го порядку)
inline double stageQ (int slopeIndex, int stage) noexcept
{
    static constexpr double q24[2] = { 0.5411961001461970, 1.3065629648763766 };
    return slopeIndex == 0 ? 0.7071067811865476 : q24[stage & 1];
}

// Набір коефіцієнтів HPF + LPF. Використовується і в аудіо, і для малювання.
struct FilterSpec
{
    BiquadCoeffs hp[2], lp[2];
    int stages = 1;
    bool hpOn = false, lpOn = false;

    void update (double fs, double hpfFreq, double lpfFreq, int slopeIndex)
    {
        stages = (slopeIndex == 0) ? 1 : 2;
        hpOn = hpfFreq > kHpfOffHz;
        lpOn = lpfFreq < kLpfOffHz;

        for (int s = 0; s < stages; ++s)
        {
            const double q = stageQ (slopeIndex, s);
            if (hpOn) hp[s] = BiquadCoeffs::make (true,  fs, hpfFreq, q);
            if (lpOn) lp[s] = BiquadCoeffs::make (false, fs, lpfFreq, q);
        }
    }

    double responseDb (double freq, double fs) const
    {
        double mag = 1.0;
        for (int s = 0; s < stages; ++s)
        {
            if (hpOn) mag *= hp[s].magnitude (freq, fs);
            if (lpOn) mag *= lp[s].magnitude (freq, fs);
        }
        return 20.0 * std::log10 (std::max (mag, 1.0e-6));
    }
};

//==============================================================================
// Гранулярний pitch-shifter: два зчитувальні "голови" у кільцевому буфері,
// зсунуті на пів вікна, з Hann-перехрестям. ratio = 2^(півтони/12).
class PitchShifter
{
public:
    void prepare (double sampleRate)
    {
        windowLen = (float) std::max (256.0, std::floor (0.06 * sampleRate)); // ~60 мс
        int n = 1;
        while (n < (int) windowLen * 2 + 8) n <<= 1;
        buffer.assign ((size_t) n, 0.0f);
        mask = n - 1;
        reset();
    }

    void reset() noexcept
    {
        std::fill (buffer.begin(), buffer.end(), 0.0f);
        writePos = 0;
        phase = 0.0f;
    }

    float process (float x, float ratio) noexcept
    {
        buffer[(size_t) writePos] = x;

        phase += (1.0f - ratio) / windowLen;
        phase -= std::floor (phase);

        float phase2 = phase + 0.5f;
        if (phase2 >= 1.0f) phase2 -= 1.0f;

        const float twoPi = (float) (2.0 * kPi);
        const float g1 = 0.5f - 0.5f * std::cos (twoPi * phase);
        const float g2 = 0.5f - 0.5f * std::cos (twoPi * phase2);

        const float out = g1 * readAt (phase  * windowLen + 2.0f)
                        + g2 * readAt (phase2 * windowLen + 2.0f);

        writePos = (writePos + 1) & mask;
        return out;
    }

private:
    inline float readAt (float delay) const noexcept
    {
        const float rp = (float) writePos - delay;
        const int i0f = (int) std::floor (rp);
        const float frac = rp - (float) i0f;
        const int i0 = i0f & mask;
        const int i1 = (i0 + 1) & mask;
        return buffer[(size_t) i0] + (buffer[(size_t) i1] - buffer[(size_t) i0]) * frac;
    }

    std::vector<float> buffer;
    int mask = 0, writePos = 0;
    float windowLen = 2048.0f, phase = 0.0f;
};
} // namespace rose
